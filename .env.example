# Copy this file to .env and uncomment what you want to change.
# .env is read by run_guard.py on launch (and passed on to the server); it is not committed.
# A real environment variable with the same name takes precedence over this file.

# Seconds the watchdog waits before restarting the server after it exits (1-300, default 3).
# GUARD_RESTART_DELAY=3

# Optional overrides for Recorded Playback's DVR connection (default: the saved Settings).
# DVR_IP=192.168.5.11
# DVR_PORT=554
# DVR_USER=admin
# DVR_PASS=
